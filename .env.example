# Supabase – finn disse under Project Settings > API i Supabase-dashbordet
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # "service_role" key (ikke anon key)

# Vite – eksponeres til frontend
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...  # "anon" public key

# Admin-passord for /admin-siden
ADMIN_PASSWORD=vm2026admin

# Valgfri: football-data.org API-nøkkel for live-resultater
VITE_FOOTBALL_API_KEY=

# Kun for lokal utvikling
PORT=3001
